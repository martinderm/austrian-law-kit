{
  "id": "austrian-law-kit",
  "name": "Austrian Law Kit",
  "description": "OpenClaw-Plugin für österreichische Rechtsquellen mit RIS als Primärquelle und optionaler JUSLINE-Sekundärquelle.",
  "version": "0.18.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cacheRoot": {
        "type": "string",
        "description": "Optionaler Override für den Cache-Pfad; ohne Override wird der Workspace des aufrufenden Agenten verwendet"
      },
      "risBaseUrl": {
        "type": "string",
        "description": "Basis-URL für RIS HTML-/Dokument-Abrufe",
        "default": "https://www.ris.bka.gv.at"
      },
      "risApiBaseUrl": {
        "type": "string",
        "description": "Basis-URL für die offizielle OGD-RIS-API",
        "default": "https://data.bka.gv.at/ris/api/v2.6/"
      },
      "juslineBaseUrl": {
        "type": "string",
        "description": "Basis-URL für JUSLINE",
        "default": "https://www.jusline.at"
      },
      "enableJusline": {
        "type": "boolean",
        "description": "Sekundärquelle aktivieren (fachlich weiterhin nur opt-in)",
        "default": true
      }
    }
  }
}
