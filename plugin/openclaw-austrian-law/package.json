{
  "name": "austrian-law-kit",
  "version": "0.1.0",
  "description": "Native Austrian law plugin kit for OpenClaw.",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx bin/cli.ts",
    "cli:dist": "node dist/bin/cli.js",
    "test:parser-smoke": "tsx tests/parser-smoke.test.ts",
    "test:tool-smoke": "tsx tests/tool-smoke.test.ts",
    "test:cli-json": "tsx tests/cli-json.test.ts",
    "test:legal-regression": "tsx tests/legal-regression.test.ts",
    "test:canonical-laws": "tsx tests/canonical-laws.test.ts",
    "test:jusline-detail": "tsx tests/jusline-decision-detail.test.ts",
    "test:smoke": "npm run test:parser-smoke && npm run test:tool-smoke && npm run test:canonical-laws && npm run test:jusline-detail && npm run test:legal-regression && npm run test:cli-json",
    "test": "npm run test:smoke"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
